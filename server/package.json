{
  "name": "commonplace",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "cli": "node dist/cli/cli.js",
    "backfill-nicks": "npm run build && node dist/cli/backfill-nicks.js",
    "dev": "NODE_ENV=development nodemon --exec npm run restart",
    "import": "node dist/cli/import.js",
    "restart": "rimraf dist && npm run build && npm run start",
    "prestart": "lsof -ti :3000 | xargs kill -9 2>/dev/null; exit 0",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.23.1",
    "morgan": "^1.10.0",
    "openai": "^5",
    "picomatch": "^4.0.4",
    "prompt-sync": "^4.2.0",
    "rimraf": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/compression": "^1.8.1",
    "eslint": "^9",
    "globals": "^17",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0"
  }
}
