{
  "name": "commonplace",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "dev": "NODE_ENV=development nodemon --exec npm run restart",
    "import": "node dist/cli/import.js",
    "restart": "rimraf dist && npm run build && npm run start",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.23.1",
    "morgan": "^1.10.0",
    "openai": "^5",
    "rimraf": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.2",
    "eslint": "^9",
    "globals": "^17",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
