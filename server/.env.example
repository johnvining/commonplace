# Copy to .env and fill in. Anything set here is read by config/index.ts
# at startup (via dotenv).
#
# In production prefer real env vars from the orchestrator (Docker, systemd,
# whatever) — .env is a developer convenience.

# JWT secret. Required for login / cookie auth.
JWT_SECRET=

# OpenAI credentials. Required for embeddings, suggestions, OCR.
OPENAI_ORG=
OPENAI_API_KEY=

# Optional. Only needed if you tunnel via ngrok.
# NGROK_AUTH=
