{
  "name": "commonplace-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "parcel index.html",
    "sass": "sass --watch style.scss:style.css",
    "prebuild": "node scripts/ensure-parcel-native.js",
    "build": "rm -rf dist .parcel-cache && parcel build index.html",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "autosize": "^6.0.1",
    "axios": "^1.15.0",
    "marked": "^17.0.1",
    "parcel": "^2.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/preset-env": "^7.23.5",
    "@eslint/js": "^9",
    "@types/autosize": "^4.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "buffer": "^6.0.3",
    "eslint": "^9",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "prettier": "^3.1.0",
    "sass": "^1.69.5",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "browser": {
    "crypto": false
  },
  "alias": {
    "process": {
      "global": "process"
    }
  }
}
