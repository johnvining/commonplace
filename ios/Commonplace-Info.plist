<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow the app to reach the Commonplace server on this Mac / LAN
	     over plain HTTP. Scoped to local networking only, so ATS still
	     applies everywhere else and this is safe in distribution builds. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.commonplacejv.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>commonplace</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
